generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                String    @id @default(uuid())
  legalName         String    @map("legal_name")
  tradeName         String?   @map("trade_name")
  ruc               String    @unique
  address           String?
  email             String
  phone             String?
  economicActivity  String?   @map("economic_activity")
  sector            String?
  logoUrl           String?   @map("logo_url")
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  areas            Area[]
  processes        Process[]
  users            User[]
  dataSubjectTypes DataSubjectType[]
  dataCategories   DataCategory[]
  dataItems        DataItem[]
  emailConfigs     EmailConfig[]
  legalBases       LegalBasis[]
  thirdParties     ThirdParty[]
  securityMeasures SecurityMeasure[]
  retentionRules   RetentionRule[]
  lifecyclePhases  LifecyclePhase[]
  risks            Risk[]
  treatments       Treatment[]
  attachments      Attachment[]
  audits           Audit[]

  @@map("companies")
}

model Role {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(true) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String @id @default(uuid())
  code        String @unique
  name        String
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id             String    @id @default(uuid())
  companyId      String?   @map("company_id")
  firstName      String    @map("first_name")
  lastName       String    @map("last_name")
  email          String    @unique
  passwordHash   String    @map("password_hash")
  phone          String?
  position       String?
  roleId         String    @map("role_id")
  areaId         String?   @map("area_id")
  isActive           Boolean   @default(true) @map("is_active")
  forcePasswordChange Boolean   @default(false) @map("force_password_change")
  lastLoginAt        DateTime? @map("last_login_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  role    Role     @relation(fields: [roleId], references: [id])
  area    Area?    @relation(fields: [areaId], references: [id], onDelete: SetNull)

  treatmentsAsResponsible Treatment[] @relation("TreatmentResponsible")
  treatmentsAsDpo         Treatment[] @relation("TreatmentDpo")

  @@map("users")
}

model Area {
  id                String    @id @default(uuid())
  companyId         String    @map("company_id")
  name              String
  description       String?
  responsibleUserId String?   @map("responsible_user_id")
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  processes Process[]
  users     User[]
  treatments Treatment[]

  @@map("areas")
}

model Process {
  id                String    @id @default(uuid())
  companyId         String    @map("company_id")
  areaId            String    @map("area_id")
  name              String
  subProcess        String?   @map("sub_process")
  description       String?
  businessObjective String?   @map("business_objective")
  responsibleUserId String?   @map("responsible_user_id")
  criticality       String?
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  area    Area    @relation(fields: [areaId], references: [id], onDelete: Cascade)
  treatments Treatment[]

  @@map("processes")
}

// ==================== CATÁLOGOS MAESTROS ====================

model DataSubjectType {
  id          String  @id @default(uuid())
  companyId   String? @map("company_id")
  code        String
  name        String
  description String?
  isActive    Boolean @default(true) @map("is_active")

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  treatmentDataSubjects TreatmentDataSubject[]

  @@unique([companyId, code])
  @@map("data_subject_types")
}

model DataCategory {
  id                String  @id @default(uuid())
  companyId         String? @map("company_id")
  code              String
  name              String
  description       String?
  isSpecialCategory Boolean @default(false) @map("is_special_category")
  isActive          Boolean @default(true) @map("is_active")

  company   Company?   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  dataItems DataItem[]

  @@unique([companyId, code])
  @@map("data_categories")
}

model DataItem {
  id             String  @id @default(uuid())
  companyId      String? @map("company_id")
  dataCategoryId String  @map("data_category_id")
  code           String
  name           String
  description    String?
  isSensitive    Boolean @default(false) @map("is_sensitive")
  isActive       Boolean @default(true) @map("is_active")

  company          Company?            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  dataCategory     DataCategory        @relation(fields: [dataCategoryId], references: [id], onDelete: Cascade)
  treatmentDataItems TreatmentDataItem[]

  @@unique([dataCategoryId, code])
  @@map("data_items")
}

model LegalBasis {
  id             String  @id @default(uuid())
  companyId      String? @map("company_id")
  code           String
  name           String
  description    String?
  legalReference String? @map("legal_reference")
  isActive       Boolean @default(true) @map("is_active")

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  treatmentLegalBases TreatmentLegalBasis[]

  @@unique([companyId, code])
  @@map("legal_bases")
}

model ThirdPartyType {
  id          String @id @default(uuid())
  code        String @unique
  name        String
  description String?

  thirdParties ThirdParty[]

  @@map("third_party_types")
}

model ThirdParty {
  id                             String  @id @default(uuid())
  companyId                      String  @map("company_id")
  name                           String
  identificationNumber           String? @map("identification_number")
  countryId                      String? @map("country_id")
  legalAddress                   String? @map("legal_address")
  contactName                    String? @map("contact_name")
  contactEmail                   String? @map("contact_email")
  contactPhone                   String? @map("contact_phone")
  thirdPartyTypeId               String? @map("third_party_type_id")
  actsAsProcessor                Boolean @default(false) @map("acts_as_processor")
  actsAsRecipient                Boolean @default(false) @map("acts_as_recipient")
  actsAsJointController          Boolean @default(false) @map("acts_as_joint_controller")
  contractExists                 Boolean @default(false) @map("contract_exists")
  confidentialityAgreementExists Boolean @default(false) @map("confidentiality_agreement_exists")
  usesSubprocessors              Boolean @default(false) @map("uses_subprocessors")
  notes                          String?
  isActive                       Boolean @default(true) @map("is_active")

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  country        Country?        @relation(fields: [countryId], references: [id], onDelete: SetNull)
  thirdPartyType ThirdPartyType? @relation(fields: [thirdPartyTypeId], references: [id], onDelete: SetNull)
  treatmentThirdParties TreatmentThirdParty[]

  @@map("third_parties")
}

model Country {
  id       String  @id @default(uuid())
  isoCode  String  @map("iso_code")
  name     String
  region   String?
  isActive Boolean @default(true) @map("is_active")

  thirdParties ThirdParty[]
  internationalTransfers InternationalTransfer[]

  @@map("countries")
}

model SecurityMeasure {
  id          String  @id @default(uuid())
  companyId   String? @map("company_id")
  code        String
  name        String
  category    String
  description String?
  isActive    Boolean @default(true) @map("is_active")

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  treatmentSecurityMeasures TreatmentSecurityMeasure[]

  @@unique([companyId, code])
  @@map("security_measures")
}

model RetentionRule {
  id             String  @id @default(uuid())
  companyId      String? @map("company_id")
  code           String
  name           String
  description    String?
  defaultTerm    String? @map("default_term")
  legalReference String? @map("legal_reference")
  isActive       Boolean @default(true) @map("is_active")

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  treatmentRetentions TreatmentRetention[]

  @@unique([companyId, code])
  @@map("retention_rules")
}

model LifecyclePhase {
  id          String  @id @default(uuid())
  companyId   String? @map("company_id")
  code        String
  name        String
  orderIndex  Int     @map("order_index")
  description String?
  isActive    Boolean @default(true) @map("is_active")

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  treatmentLifecycles TreatmentLifecycle[]

  @@unique([companyId, code])
  @@map("lifecycle_phases")
}

model Risk {
  id          String  @id @default(uuid())
  companyId   String? @map("company_id")
  code        String
  name        String
  description String?
  category    String
  severity    String
  isActive    Boolean @default(true) @map("is_active")

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, code])
  @@map("risks")
}

// ==================== NÚCLEO RAT ====================

model Treatment {
  id                      String    @id @default(uuid())
  companyId               String    @map("company_id")
  areaId                  String    @map("area_id")
  processId               String    @map("process_id")
  code                    String
  version                 Int       @default(1)
  name                    String
  shortDescription        String?   @map("short_description")
  mainPurpose             String    @map("main_purpose")
  secondaryPurposes       String?   @map("secondary_purposes")
  originOfData            String?   @map("origin_of_data")
  dataCollectionChannel   String?   @map("data_collection_channel")
  approximateVolume       String?   @map("approximate_volume")
  processingFrequency     String?   @map("processing_frequency")
  captureSystem           String?   @map("capture_system")
  storageSystem           String?   @map("storage_system")
  medium                  String?
  technologies            String?
  linkedDocuments         String?   @map("linked_documents")
  applications            String?
  automatedProcessing     Boolean   @default(false) @map("automated_processing")
  profiling               Boolean   @default(false)
  profilingDescription    String?   @map("profiling_description")
  automatedDecisions      Boolean   @default(false) @map("automated_decisions")
  automatedDecisionsDescription String? @map("automated_decisions_description")
  automatedDecisionsLogic String?   @map("automated_decisions_logic")
  automatedDecisionsConsequences String? @map("automated_decisions_consequences")
  humanInterventionAvailable Boolean @default(false) @map("human_intervention_available")
  usesAi                  Boolean   @default(false) @map("uses_ai")
  aiSystemDescription     String?   @map("ai_system_description")
  largeScaleProcessing    Boolean   @default(false) @map("large_scale_processing")
  internationalTransfer   Boolean   @default(false) @map("international_transfer")
  draftLegalBasisId       String?   @map("draft_legal_basis_id")
  validatedLegalBasisId   String?   @map("validated_legal_basis_id")
  createdByUserId         String    @map("created_by_user_id")
  treatmentResponsibleUserId String? @map("treatment_responsible_user_id")
  dpoId                   String?   @map("dpo_id")
  dpoName                 String?   @map("dpo_name")
  dpoContactEmail         String?   @map("dpo_contact_email")
  dpoContactPhone         String?   @map("dpo_contact_phone")
  jointControllerId       String?   @map("joint_controller_id")
  jointControllerName     String?   @map("joint_controller_name")
  jointControllerContact  String?   @map("joint_controller_contact")
  reviewedByUserId        String?   @map("reviewed_by_user_id")
  currentStatus           String    @default("borrador") @map("current_status")
  submissionDate          DateTime? @map("submission_date")
  approvalDate            DateTime? @map("approval_date")
  riskLevel               String?   @map("risk_level")
  highRiskFlag            Boolean   @default(false) @map("high_risk_flag")
  requiresDpia            Boolean   @default(false) @map("requires_dpia")
  dpiaStatus              String?   @map("dpia_status")
  reviewDueDate           DateTime? @map("review_due_date")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  area    Area    @relation(fields: [areaId], references: [id], onDelete: Cascade)
  process Process @relation(fields: [processId], references: [id], onDelete: Cascade)
  treatmentResponsibleUser User? @relation("TreatmentResponsible", fields: [treatmentResponsibleUserId], references: [id], onDelete: SetNull)
  dpoUser User? @relation("TreatmentDpo", fields: [dpoId], references: [id], onDelete: SetNull)

  dataSubjects              TreatmentDataSubject[]
  treatmentDataItems        TreatmentDataItem[]
  treatmentLegalBases       TreatmentLegalBasis[]
  treatmentThirdParties     TreatmentThirdParty[]
  internationalTransfers    InternationalTransfer[]
  treatmentRetention        TreatmentRetention?
  treatmentSecurityMeasures TreatmentSecurityMeasure[]
  lifecyclePhases           TreatmentLifecycle[]
  riskAssessment            RiskAssessment?
  observations              Observation[]
  versions                  TreatmentVersion[]
  statusHistory             StatusHistory[]
  attachments               Attachment[]

  @@unique([companyId, code, version])
  @@map("treatments")
}

model TreatmentDataSubject {
  id                   String @id @default(uuid())
  treatmentId          String @map("treatment_id")
  dataSubjectTypeId    String @map("data_subject_type_id")
  approximateCount     String? @map("approximate_count")
  sourceType           String? @map("source_type")
  relationshipWithCompany String? @map("relationship_with_company")
  notes                String?

  treatment Treatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)
  dataSubjectType DataSubjectType @relation(fields: [dataSubjectTypeId], references: [id], onDelete: Cascade)

  @@map("treatment_data_subjects")
}

model TreatmentDataItem {
  id                  String  @id @default(uuid())
  treatmentId         String  @map("treatment_id")
  dataItemId          String  @map("data_item_id")
  isRequired          Boolean @default(false) @map("is_required")
  isOptional          Boolean @default(false) @map("is_optional")
  sourceDirectOrIndirect String? @map("source_direct_or_indirect")
  notes               String?

  treatment Treatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)
  dataItem  DataItem  @relation(fields: [dataItemId], references: [id], onDelete: Cascade)

  @@map("treatment_data_items")
}

model TreatmentLegalBasis {
  id                String  @id @default(uuid())
  treatmentId       String  @map("treatment_id")
  legalBasisId      String  @map("legal_basis_id")
  justification     String?
  isMainBasis       Boolean @default(false) @map("is_main_basis")
  proposedByArea    Boolean @default(true) @map("proposed_by_area")
  validatedByDpo    Boolean @default(false) @map("validated_by_dpo")

  treatment Treatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)
  legalBasis LegalBasis @relation(fields: [legalBasisId], references: [id], onDelete: Cascade)

  @@map("treatment_legal_bases")
}

model TreatmentThirdParty {
  id                   String  @id @default(uuid())
  treatmentId          String  @map("treatment_id")
  thirdPartyId         String  @map("third_party_id")
  accessPurpose        String? @map("access_purpose")
  accessedDataDescription String? @map("accessed_data_description")
  involvedDataSubjects String? @map("involved_data_subjects")
  transferOutsideCountry Boolean @default(false) @map("transfer_outside_country")
  notes                String?

  treatment Treatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)
  thirdParty ThirdParty @relation(fields: [thirdPartyId], references: [id], onDelete: Cascade)

  @@map("treatment_third_parties")
}

model InternationalTransfer {
  id                     String  @id @default(uuid())
  treatmentId            String  @map("treatment_id")
  countryId              String  @map("country_id")
  thirdPartyId           String? @map("third_party_id")
  destinationName        String? @map("destination_name")
  transferredDataDescription String? @map("transferred_data_description")
  purpose                String?
  transferLegalBasis     String? @map("transfer_legal_basis")
  safeguards             String?
  approvedByDpo          Boolean @default(false) @map("approved_by_dpo")
  notes                  String?

  treatment Treatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)
  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@map("international_transfers")
}

model TreatmentRetention {
  id                    String  @id @default(uuid())
  treatmentId           String  @unique @map("treatment_id")
  retentionRuleId       String? @map("retention_rule_id")
  activeRetentionPeriod String? @map("active_retention_period")
  retentionCriteria     String? @map("retention_criteria")
  legalOrContractualBasis String? @map("legal_or_contractual_basis")
  blockingApplies       Boolean @default(false) @map("blocking_applies")
  anonymizationApplies  Boolean @default(false) @map("anonymization_applies")
  deletionApplies       Boolean @default(false) @map("deletion_applies")
  deletionMethod        String? @map("deletion_method")
  reviewFrequency       String? @map("review_frequency")
  responsibleRole       String? @map("responsible_role")
  notes                 String?

  treatment Treatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)
  retentionRule RetentionRule? @relation(fields: [retentionRuleId], references: [id], onDelete: SetNull)

  @@map("treatment_retentions")
}

model TreatmentSecurityMeasure {
  id               String  @id @default(uuid())
  treatmentId      String  @map("treatment_id")
  securityMeasureId String @map("security_measure_id")
  implemented      Boolean @default(false)
  evidence         String?
  criticality      String?
  notes            String?

  treatment Treatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)
  securityMeasure SecurityMeasure @relation(fields: [securityMeasureId], references: [id], onDelete: Cascade)

  @@map("treatment_security_measures")
}

model TreatmentLifecycle {
  id                    String  @id @default(uuid())
  treatmentId           String  @map("treatment_id")
  lifecyclePhaseId      String  @map("lifecycle_phase_id")
  activityDescription   String? @map("activity_description")
  processedDataDescription String? @map("processed_data_description")
  participants          String?
  mediumOrSupport       String? @map("medium_or_support")
  technologies          String?
  linkedDocuments       String? @map("linked_documents")
  securityMeasuresByPhase String? @map("security_measures_by_phase")
  risksByPhase          String? @map("risks_by_phase")
  phaseOrder            Int     @map("phase_order")

  treatment Treatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)
  lifecyclePhase LifecyclePhase @relation(fields: [lifecyclePhaseId], references: [id], onDelete: Cascade)

  @@map("treatment_lifecycles")
}

model RiskAssessment {
  id                   String  @id @default(uuid())
  treatmentId          String  @unique @map("treatment_id")
  usesSpecialCategories Boolean @default(false) @map("uses_special_categories")
  involvesChildren     Boolean @default(false) @map("involves_children")
  largeScale           Boolean @default(false) @map("large_scale")
  systematicMonitoring Boolean @default(false) @map("systematic_monitoring")
  profiling            Boolean @default(false)
  automatedDecisions   Boolean @default(false) @map("automated_decisions")
  videoSurveillance    Boolean @default(false) @map("video_surveillance")
  geolocation          Boolean @default(false)
  biometricData        Boolean @default(false) @map("biometric_data")
  healthData           Boolean @default(false) @map("health_data")
  criminalData         Boolean @default(false) @map("criminal_data")
  crossBorderTransfer  Boolean @default(false) @map("cross_border_transfer")
  potentialHighImpact  Boolean @default(false) @map("potential_high_impact")
  highRiskFlag         Boolean @default(false) @map("high_risk_flag")
  requiresDpia         Boolean @default(false) @map("requires_dpia")
  dpoConclusion        String? @map("dpo_conclusion")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  treatment Treatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)

  @@map("risk_assessments")
}

model Observation {
  id              String   @id @default(uuid())
  treatmentId     String   @map("treatment_id")
  sectionCode     String   @map("section_code")
  createdByUserId String   @map("created_by_user_id")
  creatorRole     String   @map("creator_role")
  message         String
  status          String   @default("abierta")
  createdAt       DateTime @default(now()) @map("created_at")

  treatment Treatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)

  @@map("observations")
}

model TreatmentVersion {
  id            String   @id @default(uuid())
  treatmentId   String   @map("treatment_id")
  versionNumber Int      @map("version_number")
  snapshotJson  String   @map("snapshot_json")
  createdByUserId String @map("created_by_user_id")
  changeReason  String?  @map("change_reason")
  createdAt     DateTime @default(now()) @map("created_at")

  treatment Treatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)

  @@map("treatment_versions")
}

model StatusHistory {
  id            String   @id @default(uuid())
  treatmentId   String   @map("treatment_id")
  previousStatus String  @map("previous_status")
  newStatus     String   @map("new_status")
  changedByUserId String @map("changed_by_user_id")
  comment       String?
  changedAt     DateTime @default(now()) @map("changed_at")

  treatment Treatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)

  @@map("status_history")
}

model Attachment {
  id              String   @id @default(uuid())
  companyId       String   @map("company_id")
  treatmentId     String?  @map("treatment_id")
  uploadedByUserId String  @map("uploaded_by_user_id")
  fileName        String   @map("file_name")
  filePath        String   @map("file_path")
  mimeType        String   @map("mime_type")
  fileSize        Int      @map("file_size")
  documentType    String   @map("document_type")
  uploadedAt      DateTime @default(now()) @map("uploaded_at")

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  treatment Treatment? @relation(fields: [treatmentId], references: [id], onDelete: Cascade)

  @@map("attachments")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("refresh_tokens")
}

model Audit {
  id            String   @id @default(uuid())
  userId        String?  @map("user_id")
  companyId     String?  @map("company_id")
  action        String
  entityName    String   @map("entity_name")
  entityId      String?  @map("entity_id")
  oldValuesJson String?  @map("old_values_json")
  newValuesJson String?  @map("new_values_json")
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  createdAt     DateTime @default(now()) @map("created_at")

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@map("audits")
}

model EmailConfig {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  smtpHost  String   @map("smtp_host")
  smtpPort  Int      @default(587) @map("smtp_port")
  smtpUser  String   @map("smtp_user")
  smtpPass  String   @map("smtp_pass")
  smtpFrom  String   @map("smtp_from")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId])
  @@map("email_configs")
}
