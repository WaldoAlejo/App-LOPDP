# ============================================
# CONFIGURACIÓN DEL SERVIDOR
# ============================================
PORT=3001
HOST=0.0.0.0
NODE_ENV=production

# ============================================
# BASE DE DATOS (PostgreSQL)
# ============================================
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public
DATABASE_URL=postgresql://username:password@localhost:5432/rat_db?schema=public

# ============================================
# JWT - SEGURIDAD CRÍTICA
# Generar con: openssl rand -base64 64
# Mínimo 32 caracteres, preferiblemente 64+
# ============================================
JWT_SECRET=GENERATE_A_SECURE_RANDOM_SECRET_MIN_64_CHARS
JWT_REFRESH_SECRET=GENERATE_A_DIFFERENT_SECURE_RANDOM_SECRET_MIN_64_CHARS
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ============================================
# FRONTEND URL (para CORS y enlaces de email)
# ============================================
FRONTEND_URL=https://tu-dominio.com

# ============================================
# SMTP - Configuración de correo (fallback)
# ============================================
SMTP_HOST=smtp.tu-proveedor.com
SMTP_PORT=587
SMTP_USER=tu-email@tu-dominio.com
SMTP_PASS=tu-contraseña-segura

# ============================================
# SUPER ADMIN INICIAL (solo para seed)
# ============================================
SEED_SUPERADMIN_EMAIL=admin@tu-dominio.com
SEED_SUPERADMIN_PASSWORD=GeneraUnaContraseñaSegura123!

# ============================================
# OPENAI (Asistente de IA)
# ============================================
OPENAI_API_KEY=sk-your-openai-api-key
