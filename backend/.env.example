# ============================================
# RAT Servientrega - Variables de Entorno
# ============================================
# Copia este archivo a .env y configura los valores

# --------------------------------------------
# SERVIDOR
# --------------------------------------------
# Puerto donde corre el backend (default: 3001)
PORT=3001

# --------------------------------------------
# BASE DE DATOS
# --------------------------------------------
# URL de conexión a PostgreSQL
DATABASE_URL=postgresql://usuario:password@host:puerto/basedatos?schema=public

# --------------------------------------------
# JWT (Autenticación)
# --------------------------------------------
# Clave secreta para tokens de acceso (genera una larga y segura)
JWT_SECRET=tu-clave-secreta-muy-larga-aqui-minimo-32-caracteres

# Clave secreta para tokens de refresh (diferente a JWT_SECRET)
JWT_REFRESH_SECRET=otra-clave-secreta-diferente-aqui-minimo-32-caracteres

# Tiempo de expiración del token de acceso
JWT_EXPIRATION=15m

# Tiempo de expiración del token de refresh
JWT_REFRESH_EXPIRATION=7d

# --------------------------------------------
# FRONTEND (IMPORTANTE)
# --------------------------------------------
# URL pública del frontend. 
# En producción: la IP o dominio de tu servidor
# En desarrollo: http://localhost:5173
FRONTEND_URL=http://35.222.179.61

# NOTA: Si usas múltiples orígenes, sepáralos con coma:
# FRONTEND_URL=http://35.222.179.61,https://tudominio.com

# --------------------------------------------
# SMTP / CORREO (Opcional - ya se configura por DB)
# --------------------------------------------
# Estas variables son fallback si no hay config en la base de datos.
# Se recomienda configurar el correo desde la UI en: Administración > Correo
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_USER=dpo@servientrega.com.ec
SMTP_PASS=tu-contraseña-aqui

# --------------------------------------------
# SEED (Solo para primera instalación)
# --------------------------------------------
# Credenciales del superadmin inicial
SEED_SUPERADMIN_EMAIL=superadmin@tuempresa.com
SEED_SUPERADMIN_PASSWORD=SuperAdminSeguro123!
